{
  "mutedVar": [
    "--p-text-muted-color=#9ca3af",
    "--p-inputtext-focus-border-color=#ffffff",
    "--p-form-field-focus-border-color=#ffffff",
    "--p-primary-color=#ffffff",
    "--p-surface-400=#4b5563",
    "--p-inputtext-hover-border-color=#4b5563",
    "--p-select-focus-border-color=#ffffff"
  ],
  "icon": {
    "cls": "lucide lucide-eye p-menu-item-icon",
    "computed": "rgb(75, 85, 99)",
    "focus": false,
    "rules": [
      " .p-menu-item-icon { color: var(--p-menu-item-icon-color)  }"
    ]
  },
  "inputFocus": {
    "cls": "p-inputtext p-component w-full h-10! px-4! py-0! text-sm! leading-[21px]! not-focus:border-surface-400!",
    "computed": "rgb(75, 85, 99)",
    "focus": true,
    "rules": [
      "@base *, ::after, ::before, ::backdrop, ::file-selector-button { border-color: currentcolor  }",
      " .p-inputtext:enabled:hover { border-color: var(--p-inputtext-hover-border-color)  }",
      " .p-inputtext:enabled:focus { border-color: var(--p-inputtext-focus-border-color)  }"
    ]
  },
  "inputFocusTop": {
    "cls": "p-inputtext p-component w-full h-10! px-4! py-0! text-sm! leading-[21px]! not-focus:border-surface-400!",
    "computed": "rgb(75, 85, 99)",
    "focus": true,
    "rules": [
      "@base *, ::after, ::before, ::backdrop, ::file-selector-button { border-top-color: currentcolor  }"
    ]
  }
}